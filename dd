--==================================================
-- STOP FLY
--==================================================

local function stopFly()

	flying = false

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	if bodyVelocity then
		bodyVelocity:Destroy()
		bodyVelocity = nil
	end

	if bodyGyro then
		bodyGyro:Destroy()
		bodyGyro = nil
	end

	if humanoid then

		humanoid.PlatformStand = false
		humanoid.AutoRotate = true

	end

	flyButton.Text = "FLY: OFF"

	flyButton.BackgroundColor3 =
		Color3.fromRGB(180, 50, 50)

end

--==================================================
-- START FLY
--==================================================

local function startFly()

	getCharacter()

	if not root or not humanoid then
		return
	end

	flying = true

	flyButton.Text = "FLY: ON"

	flyButton.BackgroundColor3 =
		Color3.fromRGB(40, 170, 80)

	humanoid.PlatformStand = true
	humanoid.AutoRotate = false

	--==================================================
	-- BODY VELOCITY
	--==================================================

	bodyVelocity =
		Instance.new("BodyVelocity")

	bodyVelocity.Name =
		"ClientFlyVelocity"

	bodyVelocity.MaxForce =
		Vector3.new(
			math.huge,
			math.huge,
			math.huge
		)

	bodyVelocity.P = 10000

	bodyVelocity.Velocity =
		Vector3.zero

	bodyVelocity.Parent =
		root

	--==================================================
	-- BODY GYRO
	--==================================================

	bodyGyro =
		Instance.new("BodyGyro")

	bodyGyro.Name =
		"ClientFlyGyro"

	bodyGyro.MaxTorque =
		Vector3.new(
			math.huge,
			math.huge,
			math.huge
		)

	bodyGyro.P = 10000
	bodyGyro.D = 500

	bodyGyro.CFrame =
		root.CFrame

	bodyGyro.Parent =
		root

	--==================================================
	-- FLY LOOP
	--==================================================

	flyConnection =
		RunService.RenderStepped:Connect(
			function()

				if not flying then
					return
				end

				if not character
					or not character.Parent
					or not root
					or not root.Parent then

					stopFly()
					return

				end

				local camera =
					workspace.CurrentCamera

				-- Analog / WASD
				local move =
					humanoid.MoveDirection

				-- Arah kamera 3D
				local look =
					camera.CFrame.LookVector

				local right =
					camera.CFrame.RightVector

				-- Input mengikuti kamera
				local forward =
					move:Dot(look)

				local sideways =
					move:Dot(right)

				local velocity =
					(look * forward)
					+
					(right * sideways)

				-- SPACE = naik
				if UserInputService:IsKeyDown(
					Enum.KeyCode.Space
				) then

					velocity +=
						Vector3.new(0, 1, 0)

				end

				-- CTRL / SHIFT = turun
				if UserInputService:IsKeyDown(
					Enum.KeyCode.LeftControl
				)
				or UserInputService:IsKeyDown(
					Enum.KeyCode.LeftShift
				) then

					velocity -=
						Vector3.new(0, 1, 0)

				end

				if velocity.Magnitude > 1 then

					velocity =
						velocity.Unit

				end

				bodyVelocity.Velocity =
					velocity * flySpeed

				-- Karakter menghadap kamera
				if look.Magnitude > 0 then

					bodyGyro.CFrame =
						CFrame.lookAt(
							root.Position,
							root.Position + look
						)

				end

			end
		)

end

--==================================================
-- NOCLIP
--==================================================

local function setNoclip(state)

	noclip = state

	if noclipConnection then

		noclipConnection:Disconnect()
		noclipConnection = nil

	end

	if not noclip then

		if character then

			for _, object in ipairs(
				character:GetDescendants()
			) do

				if object:IsA("BasePart") then

					object.CanCollide = true

				end

			end

		end

		noclipButton.Text =
			"NO CLIP: OFF"

		noclipButton.BackgroundColor3 =
			Color3.fromRGB(180, 50, 50)

		return

	end

	noclipButton.Text =
		"NO CLIP: ON"

	noclipButton.BackgroundColor3 =
		Color3.fromRGB(40, 170, 80)

	noclipConnection =
		RunService.Stepped:Connect(
			function()

				if not noclip then
					return
				end

				if not character then
					return
				end

				for _, object in ipairs(
					character:GetDescendants()
				) do

					if object:IsA("BasePart") then

						object.CanCollide = false

					end

				end

			end
		)

end

--==================================================
-- FIND PLAYER
--==================================================

local function findPlayer(text)

	if not text or text == "" then
		return nil
	end

	text = string.lower(text)

	-- Exact username
	for _, target in ipairs(
		Players:GetPlayers()
	) do

		if string.lower(target.Name) == text then

			return target

		end

	end

	-- Exact display name
	for _, target in ipairs(
		Players:GetPlayers()
	) do

		if string.lower(
			target.DisplayName
		) == text then

			return target

		end

	end

	-- Partial username
	for _, target in ipairs(
		Players:GetPlayers()
	) do

		if string.sub(
			string.lower(target.Name),
			1,
			#text
		) == text then

			return target

		end

	end

	-- Partial display name
	for _, target in ipairs(
		Players:GetPlayers()
	) do

		if string.sub(
			string.lower(target.DisplayName),
			1,
			#text
		) == text then

			return target

		end

	end

	return nil

end

--==================================================
-- TELEPORT
--==================================================

local function teleportToPlayer()

	local text =
		playerBox.Text

	if text == "" then

		statusLabel.Text =
			"Masukkan Username / DisplayName!"

		return

	end

	local target =
		findPlayer(text)

	if not target then

		statusLabel.Text =
			"Player tidak ditemukan!"

		return

	end

	if target == player then

		statusLabel.Text =
			"Tidak bisa teleport ke diri sendiri!"

		return

	end

	local targetCharacter =
		target.Character

	if not targetCharacter then

		statusLabel.Text =
			"Character target belum siap!"

		return

	end

	local targetRoot =
		targetCharacter:FindFirstChild(
			"HumanoidRootPart"
		)

	if not targetRoot then

		statusLabel.Text =
			"Target belum punya RootPart!"

		return

	end

	getCharacter()

	if not root then
		return
	end

	root.CFrame =
		targetRoot.CFrame *
		CFrame.new(3, 0, 0)

	statusLabel.Text =
		"Teleport: " ..
		target.DisplayName

end

--==================================================
-- FLY SPEED
--==================================================

local function updateFlySpeed()

	local value =
		tonumber(flySpeedBox.Text)

	if value then

		flySpeed =
			math.clamp(
				value,
				1,
				1000
			)

	end

	flySpeedBox.Text =
		tostring(flySpeed)

	statusLabel.Text =
		"Fly: " ..
		flySpeed ..
		" | Character: " ..
		characterSpeed

end

--==================================================
-- CHARACTER SPEED
--==================================================

local function updateCharacterSpeed()

	local value =
		tonumber(characterSpeedBox.Text)

	if value then

		characterSpeed =
			math.clamp(
				value,
				1,
				500
			)

	end

	characterSpeedBox.Text =
		tostring(characterSpeed)

	-- Terapkan langsung
	if humanoid then

		humanoid.WalkSpeed =
			characterSpeed

	end

	statusLabel.Text =
		"Fly: " ..
		flySpeed ..
		" | Character: " ..
		characterSpeed

end

